#include <stdio.h>
int isPrime(int n) {
if (n <= 1) {
return 0;
}
for (int i = 2; i * i <= n; i++) {
if (n % i == 0) {
return 0;
}
}
return 1;
}
int main(void) {
int num;
printf("Введіть ціле число для перевірки: ");
scanf("%d", &num);
if (isPrime(num)) {
printf("Число %d є ПРОСТИМ.\n", num);
} else {
printf("Число %d НЕ є простим.\n", num);
}
return 0;
}