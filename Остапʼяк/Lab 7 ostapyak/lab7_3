#include <stdio.h>
#include <math.h>
double f(double x, double N, double A) {
return N * x + A;
}
int main(void) {
double N = 12.0;
double A = 18.0;
double a = -100.0;
double b = 100.0;
double eps = 0.001;
double c;
if (f(a, N, A) * f(b, N, A) > 0) {
printf("На заданому інтервалі немає кореня!\n");
return 1;
}
while ((b - a) >= eps) {
c = (a + b) / 2.0;
if (f(c, N, A) == 0.0) {
break;
}
else if (f(a, N, A) * f(c, N, A) < 0) {
b = c;
} else {
a = c;
}
}
printf("Розв'язок рівняння %.0fx + %.0f = 0: x = %.4f\n", N, A, c);
return 0;
}