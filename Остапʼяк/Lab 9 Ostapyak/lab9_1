#include <stdio.h>
#include <string.h>
int main(void) {
char str[200];
printf("Введіть прислів'я (мінімум 7 слів):\n");
fgets(str, sizeof(str), stdin);
str[strcspn(str, "\n")] = '\0';
printf("\nРезультат (слова у зворотному порядку символів):\n");
char word[50];
int j = 0;
for (int i = 0; i <= strlen(str); i++) {
if (str[i] == ' ' || str[i] == '\0') {
word[j] = '\0';
for (int k = strlen(word) - 1; k >= 0; k--) {
printf("%c", word[k]);
}
printf("\n");
j = 0;
} else {
word[j++] = str[i];
}
}
return 0;
}