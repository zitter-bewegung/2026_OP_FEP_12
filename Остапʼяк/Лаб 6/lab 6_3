#include <stdio.h>
int main(void) {
int n;
printf("Введіть ціле число N (від 7 до 12): ");
scanf("%d", &n);
if (n < 7 || n > 12) {
printf("Помилка! Число N має бути від 7 до 12.\n");
return 1;
}
int sum = 0;
int current, min, max;
for (int i = 0; i < n; i++) {
printf("Введіть ціле число %d: ", i + 1);
scanf("%d", &current);
sum += current; // Додаємо до суми
if (i == 0) {
min = current;
max = current;
} else {
if (current < min) {
min = current;
}
if (current > max) {
max = current;
}
}
}
float average = (float)sum / n;
printf("\n--- Результати ---\n");
printf("Сума: %d\n", sum);
printf("Середнє арифметичне: %.2f\n", average);
printf("Мінімум: %d\n", min);
printf("Максимум: %d\n", max);
return 0;